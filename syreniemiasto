const Input = {
  keys: {}, pressed: {}, pad: { x: 0, y: 0, thr: 0, btn: [], prev: [] },
  init(){
    addEventListener('keydown', e => {
      if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space','F3','Tab'].includes(e.code)) e.preventDefault();
      Snd.unlock(); if (!e.repeat) this.pressed[e.code] = true;
      this.keys[e.code] = true;
    });
    addEventListener('keyup', e => { this.keys[e.code] = false; });
    addEventListener('blur', () => { this.keys = {}; });
    addEventListener('pointerdown', () => Snd.unlock());
  },
  down(...codes){ for (const c of codes) if (this.keys[c]) return true; return false; },
  hit(...codes){ for (const c of codes) if (this.pressed[c]) return true; return false; },
  // Optional gamepad: left stick = move, A = run, X = use, Start = pause, Back = map
  pollPad(){
    const p = this.pad; p.x = p.y = p.thr = 0; p.prev = p.btn; p.btn = [];
    let gp = null;
    try { const l = navigator.getGamepads ? navigator.getGamepads() : []; for (const g of l) if (g) { gp = g; break; } } catch (e) {}
    if (!gp) return;
    if (Math.abs(gp.axes[0]) > 0.25) p.x = gp.axes[0];
    if (Math.abs(gp.axes[1]) > 0.25) p.y = gp.axes[1];
    p.btn = gp.buttons.map(b => b.pressed);
    p.thr = (gp.buttons[7] ? gp.buttons[7].value : 0) - (gp.buttons[6] ? gp.buttons[6].value : 0);
    const edge = (i, code) => { if (p.btn[i] && !p.prev[i]) this.pressed[code] = true; };
    edge(2, 'KeyE'); edge(9, 'Escape'); edge(8, 'KeyM');
  },
  axisX(){ return (this.down('KeyD','ArrowRight') ? 1 : 0) - (this.down('KeyA','ArrowLeft') ? 1 : 0) + this.pad.x; },
  axisY(){ return (this.down('KeyS','ArrowDown') ? 1 : 0) - (this.down('KeyW','ArrowUp') ? 1 : 0) + this.pad.y; },
  run(){ return this.down('ShiftLeft','ShiftRight') || !!this.pad.btn[0]; },
  endFrame(){ this.pressed = {}; },
};

