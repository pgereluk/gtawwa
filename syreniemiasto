const Activities = {
  stopT: 0,
  // On foot: phones, gun shop, safehouses, rampages. Runs before the car prompt and swallows the E key.
  foot(p, game){
    for (const mk of game.markers) { if (Math.abs(mk.x - p.x) + Math.abs(mk.y - p.y) > 30 || !game.markerOn(mk)) continue; const E = Input.hit('KeyE'); let txt;
      switch (mk.kind) {
        case 'phone': txt = L.phone + STORY[mk.ref].name; if (E) Mission.start(STORY[mk.ref], game, mk.ref); break;
        case 'rampage': txt = L.rampP + SIDES[mk.ref].name; if (E) Mission.start(SIDES[mk.ref], game, -1); break;
        case 'guns': txt = L.gunsP; if (E) game.openShop(); break;
        case 'safe': { const price = SAFE_PRICE[mk.ref], name = L.safeNames[mk.ref];
          if (game.safe[mk.ref]) { txt = L.safeSave; if (E) { if (game.money < 50) game.toast(L.noCash); else { game.money -= 50; p.hp = 100; game.saveGame(); game.toast(L.saved); } } }
          else { txt = L.safeBuy + name + ' ($' + price + ')'; if (E) { if (game.money < price) game.toast(L.noCash); else { game.money -= price; game.safe[mk.ref] = true; game.saveGame(); game.toast(L.bought + name); } } } break; }
        default: continue;
      }
      game.prompt = txt; if (E) delete Input.pressed.KeyE; return; }
  },
  // In a car: respray, steal-to-order garage and race starts trigger when you stop on the marker; ramps when you hit them fast.
  drive(dt, game){
    const p = game.player, v = p.car; if (!v) { this.stopT = 0; return; }
    let on = false;
    for (const mk of game.markers) { if (Math.abs(mk.x - v.x) + Math.abs(mk.y - v.y) > 44 || !game.markerOn(mk)) continue;
      const stopped = v.speed < 15 && game.time > (mk.cd || 0) && (this.stopT += dt) > .6; if (stopped) { mk.cd = game.time + 4; this.stopT = 0; }
      if (mk.kind === 'spray') { const cost = 150 + game.wanted.stars * 100; game.prompt = L.sprayP + cost + ')'; on = true;
        if (stopped) { if (game.money < cost) game.toast(L.noCash); else { game.money -= cost; v.hp = 100; v.burn = 0; let c = v.color; while (c === v.color) c = pickOf(CIV_COLORS);
          if (!v.cop && v.type !== 'taxi') { v.color = c; v.sprite = carSprite(v.type, c); } game.clearWanted(); FX.burst(P_SMOKE, v.x, v.y, 14, 60, .9, 7); game.toast(L.sprayDone); } } }
      else if (mk.kind === 'order') { const o = ORDERS[game.orderI % ORDERS.length]; on = true;
        if (v.type !== o[0]) game.prompt = L.orderWant + MODELS[o[0]].name + ' ($' + o[1] + ')';
        else { game.prompt = L.orderStop; if (stopped) { const pay = Math.round(o[1] * (.5 + .5 * v.hp / 100)); p.exitCar(game); if (!p.car) { v.gone = true; game.money += pay; game.addScore(pay); game.orderI++; game.toast(L.orderDone + pay); } } } }
      else if (mk.kind === 'race' && !Mission.cur) { game.prompt = L.raceP + SIDES[mk.ref].name; on = true; if (stopped) { Mission.start(SIDES[mk.ref], game, -1); } }
    }
    if (!on && this.stopT > 0) this.stopT = 0;
    if (!v.air) for (const r of RAMPS) { if (Math.abs(r.x - v.x) + Math.abs(r.y - v.y) > 26 || v.speed < 240) continue;
      let da = Math.atan2(v.vy, v.vx) - r.ang; while (da > Math.PI) da -= 6.2832; while (da < -Math.PI) da += 6.2832; if (Math.abs(da) > .6) continue;
      v.air = v.airMax = clamp(v.speed / 380, .5, 1.4); v.jump = { x: v.x, y: v.y }; }
  },
  landed(v, game){
    FX.burst(P_SPARK, v.x, v.y, 8, 140, .3, 2); FX.burst(P_SMOKE, v.x, v.y, 6, 50, .6, 6); game.shake = 6;
    if (v.driver !== game.player || !v.jump) return; const m = Math.round(Math.hypot(v.x - v.jump.x, v.y - v.jump.y) * 3 / 32), cash = m * 5;
    game.money += cash; game.addScore(m * 10); if (!game.best.jump || m > game.best.jump) game.best.jump = m; game.toast(L.jump + m + ' m! +$' + cash + ' · ' + L.best + ': ' + game.best.jump + ' m');
  },
};

// =============================== PLAYER =============================
class Player {
  constructor(){ this.x = this.y = this.px = this.py = 0; this.r = 7; this.ang = Math.PI / 2; this.phase = 0; this.moving = false;
    this.state = 'foot'; this.timer = 0; this.roof = false; this.hp = 100; this.car = null; this.cd = 0; this.swing = 0; this.resetGear(); }
  resetGear(){ this.ammo = { fist: 1, pistol: 0, shotgun: 0, smg: 0, grenade: 0, molotov: 0 }; this.wi = 0; this.armor = 0; }
  weaponKey(){ return WORDER[this.wi]; }
  cycle(dir){ for (let k = 0; k < WORDER.length; k++) { this.wi = (this.wi + dir + WORDER.length) % WORDER.length; if (this.ammo[WORDER[this.wi]] > 0) return; } this.wi = 0; }
  give(kind, n){ this.ammo[kind] += n; if (this.wi === 0) this.wi = WORDER.indexOf(kind); }
  // Keyboard-friendly aim assist: snap to a target near the facing direction (wider cone for hostiles).
  aim(game, range){
    let best = this.ang, bs = 1;
    for (const d of game.peds) { if (d.state === 'dead') continue; const dx = d.x - this.x, dy = d.y - this.y, dist = Math.hypot(dx, dy); if (dist > range || dist < 8) continue;
      const ta = Math.atan2(dy, dx); let da = ta - this.ang; while (da > Math.PI) da -= 6.2832; while (da < -Math.PI) da += 6.2832; da = Math.abs(da);
      const h = d.hostile(game); if (da > (h ? .5 : .16)) continue; const sc = da + dist / 2000 - (h ? .4 : 0); if (sc < bs) { bs = sc; best = ta; } }
    return best;
  }
  attack(game){
    const key = this.weaponKey(), wd = WEAPONS[key];
    if (this.car && key !== 'pistol' && key !== 'smg') return;
    this.cd = wd.cd;
    if (wd.melee) { this.swing = .18; const c = Math.cos(this.ang), s = Math.sin(this.ang);
      for (const d of game.peds) { if (d.state === 'dead') continue; const dx = d.x - this.x, dy = d.y - this.y, dist = Math.hypot(dx, dy) || 1; if (dist > 26 || (dx * c + dy * s) / dist < .3) continue;
        const h = d.hostile(game); Snd.punch(); d.hurt(wd.dmg, game, true); d.knock(dx / dist * 120, dy / dist * 120); if (!h) game.crime(d.law ? 12 : 3, !d.law); break; }
      return; }
