const Mission = {
  cur: null,
  start(def, game, idx){
    this.cur = { def, idx, i: -1, t: def.timer || 0, stepT: 0, hold: 0, left: 0, kills: 0, spT: 0, car: null, vehs: [], pass: null };
    game.say(def.giver, def.intro); if (def.give) game.player.give(def.give[0], def.give[1]);
    this.next(game);
  },
  next(game){
    const m = this.cur; m.i++; if (m.i >= m.def.steps.length) return this.win(game);
    const s = m.def.steps[m.i], p = game.player; m.stepT = s.timer || 0; m.hold = 0;
    if (s.t === 'enter') { const [type, tx, ty, ang] = s.spawn, v = new Vehicle(type, tx * TILE, ty * TILE, ang, type === 'taxi' ? '#e8c020' : type === 'sports' ? '#b03030' : pickOf(CIV_COLORS)); v.mission = true; game.vehicles.push(v); m.car = v; }
    else if (s.t === 'kill') { m.left = s.spawn.length; for (const [kind, fac, tx, ty] of s.spawn) { const d = Ped.make(kind, tx * TILE, ty * TILE, fac); d.angry = 1e9; d.mission = true; d.t = 1e9; game.peds.push(d); } }
    else if (s.t === 'wreck') for (const [type, tx, ty, ang, flee] of s.spawn) { let v;
      if (flee) { v = Traffic.make(game, type, tx, ty, false); v.ai.panic = 1e9; v.ai.cruise = 185; v.temp = false; } else { v = new Vehicle(type, tx * TILE, ty * TILE, ang, pickOf(CIV_COLORS)); game.vehicles.push(v); }
      v.mission = true; m.vehs.push(v); }
    else if (s.t === 'rampage') { p.give(s.weapon, s.ammo); p.wi = WORDER.indexOf(s.weapon); m.kills = 0; }
    if (s.stars) { const W = game.wanted; W.stars = Math.max(W.stars, s.stars); W.heat = Math.max(W.heat, TH[s.stars - 1]); W.evade = 0; }
    if (s.ped) { const d = Ped.make('civ', s.at[0] * TILE, s.at[1] * TILE); d.t = 1e9; d.mission = true; game.peds.push(d); m.pass = d; }
    if (s.say) game.say(m.def.giver === 'Dyspozytor Zdzich' ? 'Klient' : m.def.giver, [s.say]);
  },
  onDeath(d){ const m = this.cur; if (m) { m.left--; m.kills++; } },
  update(dt, game){
    const m = this.cur; if (!m) return; const p = game.player, s = m.def.steps[m.i];
    if (p.state === 'dead' || p.state === 'busted') return this.fail(game, p.state === 'busted' ? L.failBusted : L.failDead);
    if (p.state !== 'foot') return;
    if ((m.t > 0 && (m.t -= dt) <= 0) || (m.stepT > 0 && (m.stepT -= dt) <= 0)) return this.fail(game, L.failTime);
    if (m.car && (m.car.dead || m.car.gone) && m.def.steps.slice(m.i).some(q => q.car === 'mission' || q.t === 'enter')) return this.fail(game, L.failCar);
    switch (s.t) {
      case 'enter': if (p.car === m.car) this.next(game); break;
      case 'goto': { if (Math.hypot(p.x - s.at[0] * TILE, p.y - s.at[1] * TILE) > (s.r || 44)) break;
        if ((s.car === 'mission' && p.car !== m.car) || (s.car === 'any' && !p.car) || (s.foot && p.car) || (s.stop && p.car && p.car.speed > 25)) break;
        if (m.pass) { m.pass.gone = true; m.pass = null; } this.next(game); break; }
      case 'kill': if (m.left <= 0) this.next(game); break;
      case 'wreck': if (m.vehs.every(v => v.dead || v.gone)) this.next(game); else if (m.vehs.some(v => v.ai && !v.dead && Math.abs(v.x - p.x) + Math.abs(v.y - p.y) > 1700)) this.fail(game, L.failAway); break;
      case 'lose': if (!game.wanted.stars) this.next(game); break;
      case 'hold': if (!p.car && Math.hypot(p.x - s.at[0] * TILE, p.y - s.at[1] * TILE) < s.r) { if ((m.hold += dt) >= s.sec) { if (s.loot) { game.money += s.loot; game.toast(L.got + L.pkNames.cash + ' $' + s.loot); } this.next(game); } }
        else m.hold = Math.max(0, m.hold - dt * 2); break;
      case 'rampage': { if (m.kills >= s.n) { this.next(game); break; }
        if ((m.spT -= dt) > 0) break; m.spT = .7; let alive = 0; for (const d of game.peds) if (d.mission && d.state !== 'dead') alive++;
        if (alive < 5) for (let k = 0; k < 8; k++) { const a = Math.random() * 6.283, r = 190 + Math.random() * 140, tx = Math.floor((p.x + Math.cos(a) * r) / TILE), ty = Math.floor((p.y + Math.sin(a) * r) / TILE);
          if (!game.world.walkOk(tx, ty)) continue; const d = Ped.make('gang', (tx + .5) * TILE, (ty + .5) * TILE, s.fac); d.angry = 1e9; d.mission = true; d.state = 'chase'; game.peds.push(d); break; } }
    }
  },
  // Where the player should go right now (for the blip and the on-screen arrow).
  target(game){
    const m = this.cur; if (!m) return null; const s = m.def.steps[m.i]; if (!s) return null;
    if (s.t === 'goto' || s.t === 'hold') return { x: s.at[0] * TILE, y: s.at[1] * TILE, r: s.r || 44 };
    if (s.t === 'enter') return { x: m.car.x, y: m.car.y, r: 30 };
    if (s.t === 'wreck') { for (const v of m.vehs) if (!v.dead && !v.gone) return { x: v.x, y: v.y, r: 34 }; }
    if (s.t === 'kill' || s.t === 'rampage') { let b = null, bd = Infinity; for (const d of game.peds) if (d.mission && d.state !== 'dead') { const q = Math.abs(d.x - game.player.x) + Math.abs(d.y - game.player.y); if (q < bd) { bd = q; b = d; } }
      if (b) return { x: b.x, y: b.y, r: 16 }; }
    return null;
  },
  text(){
    const m = this.cur; if (!m) return ''; const s = m.def.steps[m.i]; if (!s) return ''; let t = s.text;
    if (s.t === 'kill') t += ' (' + L.left + ': ' + Math.max(0, m.left) + ')'; else if (s.t === 'rampage') t += ' ' + m.kills + '/' + s.n;
    else if (s.t === 'hold') t += ' ' + Math.floor(m.hold) + '/' + s.sec + ' s'; else if (s.t === 'wreck') t += ' (' + L.left + ': ' + m.vehs.filter(v => !v.dead && !v.gone).length + ')';
    return t;
  },
  timeLeft(){ const m = this.cur; if (!m) return 0; return m.stepT > 0 && (m.t <= 0 || m.stepT < m.t) ? m.stepT : m.t; },
  cleanup(game){
    const m = this.cur; for (const d of game.peds) if (d.mission) { d.mission = false; d.angry = 0; d.leave = true; if (d.t > 100) d.t = 0; }
    for (const v of game.vehicles) if (v.mission) { v.mission = false; v.temp = true; if (v.ai) { v.ai.panic = 0; v.ai.cruise = 170; } }
    this.cur = null; return m;
  },
  win(game){
    const m = this.cleanup(game), def = m.def; game.money += def.reward; game.addScore(def.reward); Snd.jingle(true); HUD.banner(L.missionDone, def.name + ' · +$' + def.reward);
    if (m.idx >= 0) { game.done = Math.max(game.done, m.idx + 1);
      if (def.unlock && def.unlock > game.unlocked) { game.unlocked = def.unlock; game.toast(L.unlocked + L.districts[def.unlock - 1]); }
      const lines = [def.outro]; if (game.done >= STORY.length) lines.push(L.end); game.say(def.giver, lines); game.saveGame(); }
    else if (def.kind === 'race') { const tm = Math.round((def.timer - m.t) * 10) / 10; if (!game.best[def.name] || tm < game.best[def.name]) game.best[def.name] = tm; game.toast(L.time + ': ' + tm + ' s · ' + L.best + ': ' + game.best[def.name] + ' s'); }
  },
  fail(game, why){ const m = this.cleanup(game); Snd.jingle(false); HUD.banner(L.missionFail, m.def.name + ' · ' + why); },
};

