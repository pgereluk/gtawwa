  key: 'syrenie-miasto-v1',
  read(){ try { return JSON.parse(localStorage.getItem(this.key)) || {}; } catch (e) { return {}; } },
  write(patch){ try { const d = Object.assign(this.read(), patch); localStorage.setItem(this.key, JSON.stringify(d)); } catch (e) {} },
  clearGame(){ try { const d = this.read(); delete d.game; localStorage.setItem(this.key, JSON.stringify(d)); } catch (e) {} },
};

