    this.bBuckets = []; this.pBuckets = [];
    for (let i = 0; i < NCH * NCH; i++) { this.bBuckets.push([]); this.pBuckets.push([]); }
    this.chunks = new Map(); this.chunkTick = 0; this.buildBudget = 0;
    this.rng = mulberry32(1997);
    this.generate();
    this.findXings();
    this.buildMap();
    this.makeSprites();
  }
  // ---- helpers ----
  riverX(y){ return 128 + 6 * Math.sin(y / 30) + 2 * Math.sin(y / 11 + 1); }
  inb(x, y){ return x >= 0 && y >= 0 && x < MAP && y < MAP; }
  tAt(x, y){ return this.inb(x, y) ? this.tiles[y * MAP + x] : -1; }
  set(x, y, t){ if (this.inb(x, y)) this.tiles[y * MAP + x] = t; }
  rect(x0, y0, x1, y1, t, only){ for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++)
    if (only === undefined || only.includes(this.tAt(x, y))) this.set(x, y, t); }
  ri(a){ return a[0] + Math.floor(this.rng() * (a[1] - a[0] + 1)); }
  pick(a){ return a[Math.floor(this.rng() * a.length)]; }
  solidAt(px, py){ const tx = Math.floor(px / TILE), ty = Math.floor(py / TILE);
    if (!this.inb(tx, ty)) return true; return !!SOLID[this.tiles[ty * MAP + tx]]; }
  boxSolid(x, y, r){ return this.solidAt(x - r, y - r) || this.solidAt(x + r, y - r) || this.solidAt(x - r, y + r) || this.solidAt(x + r, y + r); }
  // Axis-separated circle (as box) movement against solid tiles.
  move(e, dx, dy){
    const nx = e.x + dx; if (!this.boxSolid(nx, e.y, e.r)) e.x = nx;
    const ny = e.y + dy; if (!this.boxSolid(e.x, ny, e.r)) e.y = ny;
  }
  isWater(px, py){ const tx = Math.floor(px / TILE), ty = Math.floor(py / TILE);
    return this.tAt(tx, ty) === T.WATER; }
  // Intersections (connected blocks of rdir 3 tiles): ids for traffic lights and AI route choice.
  findXings(){
    this.xid = new Uint16Array(MAP * MAP); this.xings = [null];
    for (let y = 0; y < MAP; y++) for (let x = 0; x < MAP; x++) { const i = y * MAP + x; if (this.rdir[i] !== 3 || this.xid[i]) continue;
      const X = { id: this.xings.length, x0: x, y0: y, x1: x, y1: y, n: 0, off: hash(x, y) * 14, round: false }, st = [i]; this.xid[i] = X.id;
      while (st.length) { const j = st.pop(), jx = j % MAP, jy = (j / MAP) | 0; X.n++;
        X.x0 = Math.min(X.x0, jx); X.x1 = Math.max(X.x1, jx); X.y0 = Math.min(X.y0, jy); X.y1 = Math.max(X.y1, jy);
        for (const k of [j + 1, j - 1, j + MAP, j - MAP]) if (k >= 0 && k < MAP * MAP && this.rdir[k] === 3 && !this.xid[k]) { this.xid[k] = X.id; st.push(k); } }
      X.round = X.n > 40; this.xings.push(X); }
    this.railX = []; for (let y = 1; y < MAP; y++) if (this.tiles[y * MAP + 186] === T.ROAD && this.tiles[(y - 1) * MAP + 186] !== T.ROAD) this.railX.push(y);
    this.stations = [this.freeNear(43, 84), this.freeNear(176, 94)];
  }
  // Traffic light state for an approach axis: 0 green, 1 yellow, 2 red.
  light(X, horiz, time){ const t = (time + X.off) % 14; return horiz ? (t >= 7 && t < 13 ? 0 : t >= 13 ? 1 : 2) : (t < 6 ? 0 : t < 7 ? 1 : 2); }
  // Tiles pedestrians like to walk on (crosswalks count).
  walkOk(tx, ty){ if (!this.inb(tx, ty)) return false; const i = ty * MAP + tx, t = this.tiles[i];
    return t === T.SIDE || t === T.PLAZA || t === T.PATH || t === T.COBBLE || t === T.DIRT || t === T.PAVE || (t === T.ROAD && (this.flags[i] & F.CROSS) !== 0); }
  // Line of sight between two points (solid tiles block).
  los(x0, y0, x1, y1){ const n = Math.ceil(Math.hypot(x1 - x0, y1 - y0) / 14);
    for (let k = 1; k < n; k++) if (this.solidAt(lerp(x0, x1, k / n), lerp(y0, y1, k / n))) return false; return true; }
  // Draw a persistent mark (skid, scorch) straight into the cached ground chunk.
  paint(x, y, fn){
    const ci = Math.floor(x / CS), cj = Math.floor(y / CS), c = this.chunks.get(cj * NCH + ci); if (!c) return;
    const g = c.canvas.getContext('2d'); g.save(); g.translate(-ci * CS, -cj * CS); fn(g); g.restore();
  }
  // Nearest walkable, dry tile centre (spiral search).
  freeNear(tx, ty){
    for (let r = 0; r < 30; r++) for (let y = ty - r; y <= ty + r; y++) for (let x = tx - r; x <= tx + r; x++) {
      if (Math.max(Math.abs(x - tx), Math.abs(y - ty)) !== r) continue;
      const t = this.tAt(x, y); if (t === T.SIDE || t === T.PLAZA || t === T.PAVE) return { x: (x + .5) * TILE, y: (y + .5) * TILE };
    }
    return { x: (tx + .5) * TILE, y: (ty + .5) * TILE };
  }
  zoneAt(tx, ty){
    const i = ty * MAP + tx;
    if (this.inb(tx, ty) && (this.tiles[i] === T.WATER || (this.flags[i] & F.BRIDGE))) {
      for (const b of BRIDGES) if (ty >= b[0] && ty <= b[1] && (this.flags[i] & F.BRIDGE)) return { name: b[2], d: -1 };
      return { name: L.river, d: -1 };
    }
    for (const z of ZONES) if (tx >= z[2] && tx <= z[4] && ty >= z[3] && ty <= z[5]) return { name: z[0], d: z[1] };
    return { name: tx < 128 ? 'Bulwary Wiślane' : 'Praga', d: tx < 128 ? 0 : 1 };
  }
  streetAt(tx, ty){
    for (const [dx, dy] of [[0,0],[1,0],[-1,0],[0,1],[0,-1]]) {
      const x = tx + dx, y = ty + dy; if (this.inb(x, y) && this.rname[y * MAP + x]) return this.names[this.rname[y * MAP + x]];
    }
    return '';
  }

  // ---- generation ----
  nameId(n){ let i = this.names.indexOf(n); if (i < 0) { i = this.names.length; this.names.push(n); } return i; }
  setRoad(x, y, dir, lane, w, name, tram){
    if (!this.inb(x, y)) return; const i = y * MAP + x;
    if (tram) this.flags[i] |= tram;
    if (this.tiles[i] === T.ROAD) { if (this.rdir[i] !== dir) this.rdir[i] = 3; return; }
    if (this.tiles[i] === T.WATER) this.flags[i] |= F.BRIDGE;
    this.tiles[i] = T.ROAD; this.rdir[i] = dir; this.rlane[i] = lane; this.rw[i] = w; this.rname[i] = name;
  }
  setSide(x, y){
    if (!this.inb(x, y)) return; const i = y * MAP + x, t = this.tiles[i];
    if (t === T.WATER) { this.flags[i] |= F.BRIDGE; this.tiles[i] = T.SIDE; }
    else if (t === T.GRASS || t === T.SAND) this.tiles[i] = T.SIDE;
  }
  addB(x, y, w, h, z0, z1, kind, wall, roof, extra){
    const b = { id: this.buildings.length, tx: x, ty: y, tw: w, th: h, x: x * TILE, y: y * TILE, w: w * TILE, h: h * TILE,
      z0, z1, kind, wall, wallA: shade(wall, .85), wallB: shade(wall, .62), roof, roofEdge: shade(roof, 1.3), roofDark: shade(roof, .75),
      seed: Math.floor(this.rng() * 1e6), stamp: 0, d: 0 };
    if (extra) Object.assign(b, extra);
    this.buildings.push(b);
    if (z0 === 0) for (let j = y; j < y + h; j++) for (let i = x; i < x + w; i++) { this.set(i, j, T.BLD); this.bid[j * MAP + i] = b.id + 1; }
    const c0 = Math.floor(x / CHUNK), c1 = Math.floor((x + w - 1) / CHUNK), r0 = Math.floor(y / CHUNK), r1 = Math.floor((y + h - 1) / CHUNK);
    for (let r = r0; r <= r1; r++) for (let c = c0; c <= c1; c++) if (c >= 0 && r >= 0 && c < NCH && r < NCH) this.bBuckets[r * NCH + c].push(b);
    return b;
  }
  addProp(kind, x, y, extra){
    const p = Object.assign({ kind, x, y }, extra || {}); this.props.push(p);
    const c = clamp(Math.floor(x / CS), 0, NCH - 1), r = clamp(Math.floor(y / CS), 0, NCH - 1); this.pBuckets[r * NCH + c].push(p);
  }
  // Greedy lot filler: packs building rectangles onto free GRASS tiles.
  fill(x0, y0, x1, y1, styleName){
    const st = STYLES[styleName], ON = st.on === undefined ? T.GRASS : st.on;
    const free = (x, y, w, h) => {
      if (x + w - 1 > x1 || y + h - 1 > y1) return false;
      for (let j = y; j < y + h; j++) for (let i = x; i < x + w; i++) if (this.tAt(i, j) !== ON) return false;
      const g = st.gap;
      if (g) for (let j = y - g; j < y + h + g; j++) for (let i = x - g; i < x + w + g; i++) if (this.tAt(i, j) === T.BLD) return false;
      return true;
    };
    for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) {
      if (this.tAt(x, y) !== ON) continue;
      let w = this.ri(st.w), h = this.ri(st.h);
      if (st.long && this.rng() < .5) { const t = w; w = h; h = t; }
      const mw = Math.min(st.w[0], st.h[0]);
      while (!free(x, y, w, h)) { if (w >= h) w--; else h--; if (w < mw || h < mw) break; }
      if (w < mw || h < mw) continue;
      if (st.long && Math.max(w, h) < 3) continue;
      const kind = (w < 3 || h < 3) && styleName === 'centrum' ? 'tenement' : this.pick(st.kinds);
      const K = KINDS[kind], wall = this.pick(K.wall), roof = K.roof ? this.pick(K.roof) : shade(wall, 1.1), z = this.ri(K.z);
      this.addB(x, y, w, h, 0, z, kind, wall, roof.startsWith('#') ? roof : wall);
      if (kind === 'glass' && w >= 4 && h >= 4) this.addB(x + 1, y + 1, w - 2, h - 2, z, z + 5, 'glass', wall, roof);
    }
    if (st.ground !== T.GRASS) for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) if (this.tAt(x, y) === T.GRASS) this.set(x, y, st.ground);
  }
  generate(){
    const R = this.rng;
    // --- river (Wisła) with sandy banks ---
    for (let y = 0; y < MAP; y++) { const cx = this.riverX(y);
      for (let x = Math.floor(cx - 12); x <= Math.ceil(cx + 12); x++) { const d = Math.abs(x + .5 - cx);
        if (d < 9) this.set(x, y, T.WATER); else if (d < 11) this.set(x, y, T.SAND); } }
    // --- park lake and ponds ---
    const ell = (cx, cy, rx, ry, t, only) => { for (let y = Math.floor(cy - ry); y <= cy + ry; y++) for (let x = Math.floor(cx - rx); x <= cx + rx; x++) {
      const dx = (x + .5 - cx) / rx, dy = (y + .5 - cy) / ry; if (dx * dx + dy * dy < 1 && (!only || only.includes(this.tAt(x, y)))) this.set(x, y, t); } };
    ell(88, 161, 9, 6, T.WATER); ell(88, 161, 3.6, 2.6, T.PLAZA); ell(77, 147, 2.6, 2.2, T.WATER); ell(98, 174, 3, 2, T.WATER);
    // --- airport and port aprons ---
    this.rect(6, 190, 63, 219, T.CONC); this.rect(8, 208, 61, 211, T.RUNWAY);
    this.rect(139, 189, 183, 206, T.CONC, [T.GRASS, T.SAND]);
    // --- road network ---
    for (const [x, w, y0, y1, name, tram] of ROADS_V) { const id = this.nameId(name);
      for (let y = y0; y <= y1; y++) { for (let k = 0; k < w; k++) this.setRoad(x + k, y, 2, k, w, id, tram && (k === 1 || k === 2) ? F.TRAMV : 0);
        this.setSide(x - 1, y); this.setSide(x + w, y); }
      for (let k = -1; k <= w; k++) { this.setSide(x + k, y0 - 1); this.setSide(x + k, y1 + 1); } }
    for (const [y, w, x0, x1, name, tram] of ROADS_H) { const id = this.nameId(name);
      for (let x = x0; x <= x1; x++) { for (let k = 0; k < w; k++) this.setRoad(x, y + k, 1, k, w, id, tram && (k === 1 || k === 2) ? F.TRAMH : 0);
        this.setSide(x, y - 1); this.setSide(x, y + w); }
      for (let k = -1; k <= w; k++) { this.setSide(x0 - 1, y + k); this.setSide(x1 + 1, y + k); } }
    // --- railway (east bank) with level crossings ---
    for (let y = 0; y < MAP; y++) for (const x of [186, 187]) { const i = y * MAP + x;
      if (this.tiles[i] === T.ROAD || this.tiles[i] === T.SIDE) this.flags[i] |= F.RAILX; else this.tiles[i] = T.RAIL; }
    // --- roundabout with the palm ---
    const RX = 93, RY = 114;
