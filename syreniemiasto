class World {
  constructor(){
    const n = MAP * MAP;
    this.tiles = new Uint8Array(n); this.flags = new Uint8Array(n);
    this.rdir = new Uint8Array(n); this.rlane = new Uint8Array(n); this.rw = new Uint8Array(n); this.rname = new Uint8Array(n);
    this.bid = new Uint16Array(n);
